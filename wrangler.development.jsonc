{
  "name": "book-development",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./prototype",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "a7244cb587fd4870a40b968dfc9172a0"
    }
  ],
  "keep_vars": true
}
